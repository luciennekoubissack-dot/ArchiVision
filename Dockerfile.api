# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# Copier les manifestes de dépendances en premier pour tirer parti du cache
COPY package*.json ./
COPY nest-cli.json tsconfig*.json prisma.config.ts ./
COPY libs/ libs/
COPY apps/api/ apps/api/

RUN npm ci --ignore-scripts

# Générer le client Prisma. Chemin de schéma explicite : la CLI Prisma 7 ne
# lit plus le champ package.json#prisma.schema (utilisé en local), et sans
# --schema elle ne cherche qu'aux emplacements par défaut (./schema.prisma,
# ./prisma/schema.prisma), absents depuis /app.
RUN npx prisma generate --schema apps/api/prisma/schema.prisma

# Compiler l'API
RUN npx nest build api

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
# --omit=optional en plus de --omit=dev : la CLI Prisma (devDependency, jamais
# utilisée à l'exécution, seul `@prisma/client` copié ci-dessous l'est)
# entraîne plusieurs de ses propres dépendances en tant qu'« optional
# dependency d'une devDependency » (devOptional dans package-lock.json),
# qu'--omit=dev seul n'exclut pas. Vérifié : sans --omit=optional, l'image
# embarquait `prisma`, `mysql2`, `find-my-way`, `fast-uri`... (315 paquets,
# 8 vulnérabilités hautes/modérées d'npm audit) jamais importés par le code ;
# avec --omit=optional, 182 paquets, 0 vulnérabilité. Le seul paquet
# purement optionnel (non-dev) du lockfile est `pg-cloudflare`, un adaptateur
# pour Cloudflare Workers sans objet sur ce déploiement (connexion Postgres
# standard via `pg`).
RUN npm ci --omit=dev --omit=optional --ignore-scripts

# Copier le build et le client Prisma généré
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY apps/api/prisma/schema.prisma ./apps/api/prisma/schema.prisma

# Le conteneur tourne en utilisateur non-root (image node:alpine par défaut :
# uid/gid "node" déjà présents) plutôt qu'en root par défaut ; uploads/ doit
# exister et lui appartenir puisque l'app y écrit les logos à l'exécution.
RUN mkdir -p apps/api/uploads && chown -R node:node /app
USER node

EXPOSE 3000

CMD ["node", "dist/apps/api/src/main.js"]
