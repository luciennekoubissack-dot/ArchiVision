# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app/web

# Copier les manifestes en premier pour le cache Docker
COPY apps/web/package*.json ./

RUN npm ci --ignore-scripts

# Copier le reste des sources
COPY apps/web/ .

# Build de production Angular
RUN npm run build:prod

# ── Runtime stage : Nginx ─────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Outils nécessaires : envsubst pour substituer les variables dans nginx.conf
RUN apk add --no-cache gettext

# Supprimer la config Nginx par défaut
RUN rm /etc/nginx/conf.d/default.conf

# Template de config Nginx (variables substituées au démarrage via envsubst)
COPY nginx.conf /etc/nginx/templates/archivision.conf.template

# Copier le build Angular
COPY --from=builder /app/web/dist/web /usr/share/nginx/html

# Script de démarrage : substitue les variables puis lance Nginx
COPY docker-entrypoint-web.sh /docker-entrypoint-web.sh
RUN chmod +x /docker-entrypoint-web.sh

EXPOSE 80

CMD ["/docker-entrypoint-web.sh"]
