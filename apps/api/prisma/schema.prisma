generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (hors référentiel métier — nécessaire pour l'authentification) ──────

/// Rôles v3 — SUPERADMIN est un rôle plateforme, non rattaché à une organisation.
/// ADMINISTRATEUR est le créateur/gestionnaire de son organisation. ARCHITECTE
/// regroupe tous les autres membres (ex-DIRIGEANT/REPRESENTANT/COLLABORATEUR) :
/// ce sont eux qui construisent le référentiel d'architecture.
enum RoleUtilisateur {
  SUPERADMIN
  ADMINISTRATEUR
  ARCHITECTE
}

/// Cycle de vie d'une organisation inscrite — validée par le superadmin
/// avant que ses membres puissent se connecter (hors superadmin).
enum StatutOrganisation {
  EN_ATTENTE
  VALIDEE
  REJETEE
}

/// Statut Gap Analysis d'un élément d'architecture (toutes couches confondues) :
/// état actuel (AS_IS), état cible (TO_BE), ou inchangé entre les deux.
enum StatutElement {
  AS_IS
  TO_BE
  LES_DEUX
}

/// Cycle de vie d'une invitation envoyée par un ADMINISTRATEUR à un futur
/// membre de son organisation : en attente tant que le lien n'a pas été
/// utilisé, acceptée une fois le compte créé, révoquée si l'admin l'annule.
enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  REVOKEE
}

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  passwordHash         String
  nom                  String
  avatarUrl            String?              @map("avatar_url")
  poste                String?
  contact              String?
  organisationId       String?
  organisation         Organisation?        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role                 RoleUtilisateur
  serviceId            String?
  service              Service?             @relation("ServiceMembres", fields: [serviceId], references: [id], onDelete: SetNull)
  postesOccupes        Service[]            @relation("ServiceTitulaire")
  invitationsEnvoyees  Invitation[]         @relation("InvitationsEnvoyees")
  passwordResetTokens  PasswordResetToken[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([organisationId])
}

/// Jeton de réinitialisation de mot de passe, envoyé par e-mail. Même
/// patron que `Invitation` : jeton à usage unique dont seule l'empreinte
/// SHA-256 est stockée (`tokenHash`). Durée de vie volontairement courte
/// (1h, contre 7 jours pour une invitation) : ce jeton donne accès à un
/// compte existant, pas seulement la création d'un nouveau.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Invitation d'un futur membre à rejoindre une organisation, envoyée par
/// e-mail par un ADMINISTRATEUR. Le lien porte un jeton à usage unique dont
/// seule l'empreinte SHA-256 est stockée (`tokenHash`). À l'acceptation, un
/// `User` est créé avec le rôle prévu et l'invitation passe ACCEPTEE.
model Invitation {
  id             String           @id @default(uuid())
  email          String
  role           RoleUtilisateur
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  serviceId      String?          @map("service_id")
  service        Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  poste          String?
  contact        String?
  tokenHash      String           @unique @map("token_hash")
  statut         StatutInvitation @default(EN_ATTENTE)
  invitedById    String?          @map("invited_by_id")
  invitedBy      User?            @relation("InvitationsEnvoyees", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organisationId])
  @@index([email])
}

// ─── Organisation ─────────────────────────────────────────────────────────────

/// Représente l'entreprise modélisée (ex. K&B Groupe SARL).
/// Champs : id, nom, description — exactement ce que définit referentiel.md.
model Organisation {
  id                String             @id @default(uuid())
  nom               String
  description       String?
  logoUrl           String?            @map("logo_url")
  secteur           String?            @map("sector")
  taille            String?            @map("size")
  pays              String?            @map("country")
  ville             String?            @map("city")
  statut            StatutOrganisation @default(EN_ATTENTE)
  validatedAt       DateTime?          @map("validated_at")
  /// Vision d'architecture (étape 1 de l'assistant TOGAF ADM — phase préliminaire).
  vision            String?            @db.Text
  problemesResoudre String?            @map("problemes_resoudre") @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  // Relations inverses (Prisma les exige pour la navigation)
  capacites                CapaciteMetier[]
  elements                 ElementArchimate[]
  applications             Application[]
  zones                    ZoneUrbanisation[]
  users                    User[]
  services                 Service[]
  objectifs                Objectif[]
  partiesPrenantes         PartiePrenante[]
  bpmnProcessus            BpmnProcessus[]
  dataEntities             DataEntity[]
  techComponents           TechComponent[]
  sequenceDiagrammes       SequenceDiagramme[]
  projets                  Projet[]
  canevasRelations         CanevasRelation[]
  solutions                Solution[]
  criteresEvaluation       CritereEvaluation[]
  politiquesGouvernance    PolitiqueGouvernance[]
  demandesChangement       DemandeChangement[]
  enqueteReponses          EnqueteReponse[]
  questionnaires           Questionnaire[]
  visionCanvas             VisionCanvas?
  archiApplicativeElements ArchiApplicativeElement[]
  invitations              Invitation[]
}

// ─── Service d'entreprise (département, hiérarchique) ─────────────────────────

/// Unité organisationnelle (ex. "Direction Informatique" > "Service Support").
/// À ne pas confondre avec ElementArchimate.type = SERVICE_METIER (service
/// métier ArchiMate) — voir docs/cahier.md section 4.3.
model Service {
  id             String       @id @default(uuid())
  nom            String
  description    String?
  parentId       String?
  parent         Service?     @relation("ServiceHierarchie", fields: [parentId], references: [id])
  /// Personne qui occupe ce poste / dirige cette structure (optionnel : poste vacant).
  titulaireId    String?      @map("titulaire_id")
  titulaire      User?        @relation("ServiceTitulaire", fields: [titulaireId], references: [id], onDelete: SetNull)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  enfants     Service[]    @relation("ServiceHierarchie")
  membres     User[]       @relation("ServiceMembres")
  invitations Invitation[]

  @@index([organisationId])
  @@index([parentId])
}

// ─── Objectif stratégique (version allégée) ────────────────────────────────────

model Objectif {
  id             String        @id @default(uuid())
  nom            String
  description    String?
  sousObjectif   String?       @map("sous_objectif")
  statut         StatutElement @default(LES_DEUX)
  // Objectif AS-IS dont cet objectif TO-BE est l'évolution (analyse des écarts).
  // Null pour un objectif AS-IS ou un objectif LES_DEUX (inchangé, pas d'évolution à comparer).
  objectifAsIsId String?       @map("objectif_as_is_id")
  objectifAsIs   Objectif?     @relation("ObjectifEvolution", fields: [objectifAsIsId], references: [id], onDelete: SetNull)
  objectifsToBe  Objectif[]    @relation("ObjectifEvolution")
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organisationId])
  @@index([objectifAsIsId])
}

// ─── CapaciteMetier ───────────────────────────────────────────────────────────

/// Ce que l'organisation sait faire (ex. "Gestion des formations").
/// Champs : id, nom, description, organisationId → Organisation
model CapaciteMetier {
  id             String       @id @default(uuid())
  nom            String
  description    String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  elements ElementArchimate[]
}

// ─── ArchiMate — couche Métier uniquement en v1 ───────────────────────────────

/// Couche Motivation (Vision, Objectif d'architecture, Principe, Exigence) +
/// couche Métier. Extension volontaire au-delà des 5 valeurs métier de la v1
/// (voir docs/referentiel.md) pour permettre au canevas de représenter la
/// vision/les objectifs d'architecture aux côtés des éléments métier.
enum TypeElement {
  // Couche Motivation
  VISION
  OBJECTIF_ARCHIMATE
  PRINCIPE
  EXIGENCE
  // Couche Métier
  ACTEUR_METIER
  ROLE_METIER
  PROCESSUS_METIER
  SERVICE_METIER
  OBJET_METIER
}

/// Sous-catégorie d'une exigence (TypeElement.EXIGENCE uniquement) — module Vision.
enum CategorieExigence {
  FONCTIONNELLE
  NON_FONCTIONNELLE
}

/// 4 valeurs exactement — referentiel.md interdit d'en ajouter en v1.
enum TypeRelation {
  ASSIGNATION
  COMPOSITION
  REALISATION
  ASSOCIATION
}

/// Élément de la couche Métier ArchiMate.
/// Champs : id, nom, type, description, capaciteMetierId (optionnel), organisationId
model ElementArchimate {
  id                String             @id @default(uuid())
  nom               String
  type              TypeElement
  description       String?
  /// Uniquement pertinent quand type = EXIGENCE (module Vision).
  categorieExigence CategorieExigence? @map("categorie_exigence")
  statut            StatutElement      @default(LES_DEUX)
  /// Position/taille manuelles dans le canevas — null tant que l'utilisateur
  /// n'a pas déplacé/redimensionné l'élément (l'auto-layout s'applique alors).
  positionX         Float?             @map("position_x")
  positionY         Float?             @map("position_y")
  width             Float?             @map("width")
  height            Float?             @map("height")
  organisationId    String
  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  capaciteMetierId  String?
  capacite          CapaciteMetier?    @relation(fields: [capaciteMetierId], references: [id], onDelete: SetNull)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  relationsSource RelationArchimate[] @relation("RelationSource")
  relationsTarget RelationArchimate[] @relation("RelationTarget")

  @@index([organisationId])
  @@index([type])
}

/// Lien typé entre deux éléments ArchiMate.
/// Champs : id, type, sourceId → ElementArchimate, targetId → ElementArchimate
model RelationArchimate {
  id        String           @id @default(uuid())
  type      TypeRelation
  sourceId  String
  source    ElementArchimate @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    ElementArchimate @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([sourceId])
  @@index([targetId])
}

// ─── Canevas — relations inter-couches ─────────────────────────────────────────

/// Couche d'un élément référencé par une CanevasRelation.
enum ElementKind {
  ARCHIMATE
  APPLICATION
  TECH_COMPONENT
  DATA_ENTITY
}

/// Relation entre deux éléments du canevas, potentiellement de couches
/// différentes (ex. une Application qui réalise un Processus métier).
/// Volontairement sans clé étrangère Prisma sur sourceId/targetId — la
/// source et la cible peuvent appartenir à des tables différentes selon
/// sourceKind/targetKind. L'appartenance à l'organisation est validée en
/// code (CanevasService.resolveModel) plutôt que par une contrainte DB.
model CanevasRelation {
  id             String       @id @default(uuid())
  type           TypeRelation
  sourceKind     ElementKind
  sourceId       String
  targetKind     ElementKind
  targetId       String
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organisationId])
  @@index([sourceKind, sourceId])
  @@index([targetKind, targetId])
}

// ─── Urbanisation ─────────────────────────────────────────────────────────────

/// Application du portefeuille applicatif.
/// Champs : id, nom, description, organisationId → Organisation
model Application {
  id             String        @id @default(uuid())
  nom            String
  description    String?
  statut         StatutElement @default(LES_DEUX)
  positionX      Float?        @map("position_x")
  positionY      Float?        @map("position_y")
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  zones          ApplicationZone[]
  deploiements   TechDeploiement[]
  echangesSource ApplicationEchange[] @relation("EchangeSource")
  echangesTarget ApplicationEchange[] @relation("EchangeTarget")
  services       ApplicationService[]

  @@index([organisationId])
}

/// Service métier/technique fourni par une application (ex. "Facturation",
/// "Authentification") — identifié par la phase TOGAF Architecture Applicative.
model ApplicationService {
  id            String      @id @default(uuid())
  nom           String
  description   String?
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

/// Flux d'échange entre deux applications — diagramme de composants UML
/// (architecture applicative, étape 5 de l'assistant TOGAF ADM).
model ApplicationEchange {
  id          String      @id @default(uuid())
  sourceId    String
  source      Application @relation("EchangeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      Application @relation("EchangeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  description String?
  protocole   String?
  createdAt   DateTime    @default(now())

  @@index([sourceId])
  @@index([targetId])
}

/// 3 niveaux de la hiérarchie d'urbanisation.
enum TypeZone {
  ZONE
  QUARTIER
  ILOT
}

/// Nœud de la hiérarchie Zone > Quartier > Îlot (auto-référencée).
/// Champs : id, nom, type, parentId (nullable), organisationId → Organisation
model ZoneUrbanisation {
  id             String            @id @default(uuid())
  nom            String
  type           TypeZone
  parentId       String?
  parent         ZoneUrbanisation? @relation("ZoneHierarchie", fields: [parentId], references: [id])
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  enfants      ZoneUrbanisation[] @relation("ZoneHierarchie")
  applications ApplicationZone[]

  @@index([organisationId])
  @@index([parentId])
}

/// Table de jointure — affectation d'une application à un îlot du POS.
/// Clé primaire composite (applicationId, zoneId).
model ApplicationZone {
  applicationId String
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  zoneId        String
  zone          ZoneUrbanisation @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([applicationId, zoneId])
}

// ─── Architecture applicative (module Architecture Système) ──────────────────

/// Type d'élément du diagramme d'architecture applicative — au-delà des
/// applications du portefeuille (déjà couvertes par le diagramme de
/// composants), ce diagramme couvre aussi les utilisateurs, systèmes tiers,
/// l'infrastructure et les mécanismes de sécurité qui gravitent autour.
enum TypeElementArchiApplicative {
  APPLICATION
  UTILISATEUR_INTERNE
  UTILISATEUR_EXTERNE
  SYSTEME_EXTERNE
  BASE_DE_DONNEES
  INFRASTRUCTURE
  SECURITE
}

/// Nature du flux entre deux éléments — pilote le style de trait (plein/
/// pointillé) et sa couleur dans le diagramme généré, à la manière des
/// notations d'architecture logicielle courantes (API vs donnée vs auth).
enum TypeFluxArchiApplicative {
  API
  DONNEES
  AUTHENTIFICATION
  RESEAU
}

/// Élément du diagramme d'architecture applicative (module Architecture
/// Système, onglet dédié). Volontairement indépendant du portefeuille
/// `Application` pour ne pas faire interférer deux diagrammes sur les mêmes
/// coordonnées (même précaution que `TechDeploiement` vis-à-vis du diagramme
/// de composants, cf. docs/audit.md).
model ArchiApplicativeElement {
  id             String                      @id @default(uuid())
  nom            String
  type           TypeElementArchiApplicative
  description    String?
  positionX      Float?                      @map("position_x")
  positionY      Float?                      @map("position_y")
  organisationId String
  organisation   Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  fluxSource ArchiApplicativeFlux[] @relation("ArchiFluxSource")
  fluxTarget ArchiApplicativeFlux[] @relation("ArchiFluxTarget")

  @@index([organisationId])
}

/// Flux (interconnexion) entre deux éléments du diagramme d'architecture
/// applicative.
model ArchiApplicativeFlux {
  id        String                   @id @default(uuid())
  sourceId  String
  source    ArchiApplicativeElement  @relation("ArchiFluxSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId  String
  target    ArchiApplicativeElement  @relation("ArchiFluxTarget", fields: [targetId], references: [id], onDelete: Cascade)
  type      TypeFluxArchiApplicative @default(DONNEES)
  label     String?
  createdAt DateTime                 @default(now())

  @@index([sourceId])
  @@index([targetId])
}

// ─── Vision & parties prenantes (étape 1 de l'assistant TOGAF ADM) ────────────

/// Partie prenante externe (client, régulateur, partenaire...) — distincte des
/// Membres internes déjà représentés par User/Service.
model PartiePrenante {
  id             String       @id @default(uuid())
  nom            String
  role           String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organisationId])
}

// ─── BPMN — modélisation des processus (étape 2 de l'assistant TOGAF ADM) ─────

/// Types d'éléments BPMN 2.0 pris en charge par l'éditeur (bpmn-js).
enum TypeBpmn {
  EVENEMENT_DEBUT
  EVENEMENT_FIN
  EVENEMENT_INTERMEDIAIRE
  TACHE
  PASSERELLE_EXCLUSIVE
  PASSERELLE_PARALLELE
  PASSERELLE_INCLUSIVE
  PASSERELLE_EVENEMENTIELLE
  SOUS_PROCESSUS
}

/// Déclencheur d'un événement — pertinent uniquement quand TypeBpmn est un
/// des 3 types événement (début/intermédiaire/fin) ; pilote l'icône interne,
/// la bordure du cercle continue de coder la position dans le flux.
enum DeclencheurEvenement {
  MESSAGE
  MINUTERIE
  ERREUR
  SIGNAL
  CONDITIONNEL
  TERMINAISON
  ESCALADE
}

/// Nature d'une tâche — pertinent uniquement quand TypeBpmn = TACHE.
enum TypeTache {
  UTILISATEUR
  SERVICE
  MANUELLE
  ENVOI
  RECEPTION
  REGLE_METIER
  SCRIPT
}

/// Un diagramme de processus métier. `bpmnXml` est la source de vérité pour
/// l'éditeur bpmn-js (positions, points d'ancrage) ; BpmnElement/BpmnFlow sont
/// dérivés à la sauvegarde pour les besoins transversaux (assistant, gap
/// analysis, compteurs) — voir docs/plan superadmin+ADM pour la justification.
/// Classification d'un processus dans la cartographie de l'entreprise :
/// METIER (crée directement de la valeur pour le client), SUPPORT (nécessaire
/// au fonctionnement interne, ex. RH/IT/comptabilité), PILOTAGE (définit la
/// stratégie et pilote les autres processus, ex. gouvernance/qualité).
enum TypeProcessus {
  METIER
  SUPPORT
  PILOTAGE
}

model BpmnProcessus {
  id             String        @id @default(uuid())
  nom            String
  description    String?
  /// Étapes du processus en langage naturel, une par ligne. Sert de source à la
  /// génération d'une proposition de diagramme (événement début/fin, une tâche
  /// ou passerelle par étape, flux séquentiels) que l'utilisateur ajuste
  /// ensuite dans l'éditeur. Conservé pour permettre une régénération.
  etapes         String?       @db.Text
  type           TypeProcessus @default(METIER)
  bpmnXml        String?       @map("bpmn_xml") @db.Text
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  elements       BpmnElement[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organisationId])
}

model BpmnElement {
  id          String                @id @default(uuid())
  nom         String
  type        TypeBpmn
  declencheur DeclencheurEvenement? @map("declencheur")
  typeTache   TypeTache?            @map("type_tache")
  statut      StatutElement         @default(LES_DEUX)
  positionX   Float?                @map("position_x")
  positionY   Float?                @map("position_y")
  processusId String
  processus   BpmnProcessus         @relation(fields: [processusId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())

  flowsSource BpmnFlow[] @relation("BpmnFlowSource")
  flowsTarget BpmnFlow[] @relation("BpmnFlowTarget")

  @@index([processusId])
}

/// Flux de séquence entre deux éléments BPMN (ex. tâche → passerelle).
model BpmnFlow {
  id       String      @id @default(uuid())
  label    String?
  sourceId String
  source   BpmnElement @relation("BpmnFlowSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId String
  target   BpmnElement @relation("BpmnFlowTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
}

// ─── Architecture des données (étape 4 de l'assistant TOGAF ADM) ──────────────

/// Cardinalité d'une relation entre deux entités de données (diagramme ER/UML).
enum TypeCardinalite {
  UN_A_UN
  UN_A_PLUSIEURS
  PLUSIEURS_A_PLUSIEURS
}

model DataEntity {
  id             String        @id @default(uuid())
  nom            String
  description    String?
  proprietaire   String?
  statut         StatutElement @default(LES_DEUX)
  positionX      Float?        @map("position_x")
  positionY      Float?        @map("position_y")
  organisationId String
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attributs       DataAttribute[]
  relationsSource DataRelation[]  @relation("DataRelSource")
  relationsTarget DataRelation[]  @relation("DataRelTarget")

  @@index([organisationId])
}

/// Attribut d'une entité de données. `type` en texte libre (ex. "string",
/// "int", "date") — la variété des systèmes de typage rencontrés en entretien
/// ne justifie pas un enum fermé.
model DataAttribute {
  id       String     @id @default(uuid())
  nom      String
  type     String
  entityId String
  entity   DataEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
}

model DataRelation {
  id          String          @id @default(uuid())
  cardinalite TypeCardinalite
  label       String?
  sourceId    String
  source      DataEntity      @relation("DataRelSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      DataEntity      @relation("DataRelTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
}

// ─── Architecture technologique (étape 6 de l'assistant TOGAF ADM) ────────────

enum TypeTechComponent {
  SERVEUR
  RESEAU
  CLOUD
  BASE_DE_DONNEES
  MIDDLEWARE
}

model TechComponent {
  id             String            @id @default(uuid())
  nom            String
  type           TypeTechComponent
  description    String?
  statut         StatutElement     @default(LES_DEUX)
  positionX      Float?            @map("position_x")
  positionY      Float?            @map("position_y")
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  deploiements TechDeploiement[]

  @@index([organisationId])
}

/// Diagramme de déploiement — quelle application tourne sur quel composant technique.
model TechDeploiement {
  applicationId   String
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  techComponentId String
  techComponent   TechComponent @relation(fields: [techComponentId], references: [id], onDelete: Cascade)

  @@id([applicationId, techComponentId])
}

// ─── Diagrammes de séquence UML (architecture applicative) ────────────────────

/// Modélisé par ordre (participants, messages) plutôt que par position XY —
/// un diagramme de séquence n'est pas un problème de glisser-déposer. Rendu en
/// lecture seule, SVG généré côté serveur comme les autres vues.
model SequenceDiagramme {
  id             String       @id @default(uuid())
  nom            String
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  participants SequenceParticipant[]

  @@index([organisationId])
}

model SequenceParticipant {
  id          String            @id @default(uuid())
  nom         String
  ordre       Int
  diagrammeId String
  diagramme   SequenceDiagramme @relation(fields: [diagrammeId], references: [id], onDelete: Cascade)

  messagesEnvoyes SequenceMessage[] @relation("MessageFrom")
  messagesRecus   SequenceMessage[] @relation("MessageTo")

  @@index([diagrammeId])
}

model SequenceMessage {
  id     String              @id @default(uuid())
  label  String
  ordre  Int
  fromId String
  from   SequenceParticipant @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     SequenceParticipant @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([fromId])
  @@index([toId])
}

// ─── Roadmap de transformation (étape 8 de l'assistant TOGAF ADM) ─────────────

enum PrioriteProjet {
  HAUTE
  MOYENNE
  BASSE
}

enum StatutProjet {
  PLANIFIE
  EN_COURS
  TERMINE
}

model Projet {
  id             String         @id @default(uuid())
  nom            String
  description    String?
  priorite       PrioriteProjet @default(MOYENNE)
  coutEstime     String?        @map("cout_estime")
  dateDebut      DateTime?      @map("date_debut")
  dateFin        DateTime?      @map("date_fin")
  statut         StatutProjet   @default(PLANIFIE)
  organisationId String
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organisationId])
}

// ─── Opportunités & Solutions (phase E de l'ADM TOGAF) ────────────────────────

/// Cycle de vie d'une solution candidate face à un écart identifié.
enum StatutSolution {
  PROPOSEE
  RETENUE
  REJETEE
}

/// Avancement de la mise en œuvre d'une solution retenue (module Mise en œuvre).
enum AvancementSolution {
  NON_DEMARRE
  EN_COURS
  TERMINE
  BLOQUE
}

model Solution {
  id               String               @id @default(uuid())
  nom              String
  description      String?
  statut           StatutSolution       @default(PROPOSEE)
  planMiseOeuvre   String?              @map("plan_mise_oeuvre") @db.Text
  avancement       AvancementSolution   @default(NON_DEMARRE)
  commentaireSuivi String?              @map("commentaire_suivi") @db.Text
  organisationId   String
  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  scores           EvaluationScore[]
  conformites      ConformiteSolution[]
  gaps             SolutionGap[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([organisationId])
}

/// Domaine architectural d'où provient un écart (analyse des écarts) référencé
/// par une solution — reflète les 5 onglets du module Analyse des écarts.
enum DomaineEcart {
  OBJECTIF
  METIER
  DONNEES
  APPLICATIF
  TECHNOLOGIQUE
}

/// Lien entre une solution et l'écart (élément AS-IS/TO-BE d'un domaine
/// architectural) qu'elle est censée combler — trace la solution jusqu'au
/// besoin identifié en analyse des écarts (phase E de l'ADM TOGAF).
/// Référence par identifiant + libellé plutôt que par relation Prisma stricte
/// (l'élément source peut provenir de 5 tables différentes selon `domaine`,
/// et Prisma ne modélise pas les relations polymorphes) : la suppression de
/// l'élément d'origine ne supprime donc pas ce lien, qui devient orphelin
/// (assumé, cas rare, pas de nettoyage automatique pour l'instant).
model SolutionGap {
  id         String       @id @default(uuid())
  solutionId String
  solution   Solution     @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  domaine    DomaineEcart
  elementId  String       @map("element_id")
  elementNom String       @map("element_nom")
  createdAt  DateTime     @default(now())

  @@unique([solutionId, domaine, elementId])
  @@index([solutionId])
  @@index([domaine, elementId])
}

/// Critère de comparaison utilisé dans la matrice d'évaluation des solutions
/// (ex. "Coût", "Risque", "Valeur métier").
model CritereEvaluation {
  id             String            @id @default(uuid())
  nom            String
  description    String?
  organisationId String
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  scores         EvaluationScore[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organisationId])
}

/// Note d'une solution sur un critère — cellule de la matrice d'évaluation.
/// Pas d'organisationId propre : l'appartenance tenant est vérifiée via les
/// FK solutionId/critereId (comme ApplicationEchange/DataRelation).
model EvaluationScore {
  id          String            @id @default(uuid())
  solutionId  String
  solution    Solution          @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  critereId   String
  critere     CritereEvaluation @relation(fields: [critereId], references: [id], onDelete: Cascade)
  score       Int
  commentaire String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([solutionId, critereId])
}

// ─── Gouvernance (phase G de l'ADM TOGAF) ─────────────────────────────────────

/// Statut de conformité d'une solution vis-à-vis d'une politique de gouvernance.
enum StatutConformite {
  CONFORME
  NON_CONFORME
  A_EVALUER
}

/// Cycle de vie d'une demande de changement architectural.
enum StatutChangement {
  PROPOSE
  APPROUVE
  REJETE
  IMPLEMENTE
}

/// Règle/standard d'architecture que les solutions doivent respecter.
model PolitiqueGouvernance {
  id             String               @id @default(uuid())
  nom            String
  description    String?
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conformites    ConformiteSolution[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organisationId])
}

/// Évaluation de conformité d'une solution vis-à-vis d'une politique — cellule
/// de la matrice de conformité. Pas d'organisationId propre : appartenance
/// tenant vérifiée via les FK solutionId/politiqueId (comme EvaluationScore).
model ConformiteSolution {
  id          String               @id @default(uuid())
  solutionId  String
  solution    Solution             @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  politiqueId String
  politique   PolitiqueGouvernance @relation(fields: [politiqueId], references: [id], onDelete: Cascade)
  statut      StatutConformite     @default(A_EVALUER)
  commentaire String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([solutionId, politiqueId])
}

/// Demande de changement architectural (gestion des évolutions).
model DemandeChangement {
  id             String           @id @default(uuid())
  titre          String
  description    String?
  statut         StatutChangement @default(PROPOSE)
  organisationId String
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organisationId])
}

// ─── Évaluation et amélioration continue (phase H de l'ADM TOGAF) ─────────────

/// Réponse importée d'une enquête de satisfaction auprès des parties prenantes.
model EnqueteReponse {
  id             String       @id @default(uuid())
  repondant      String
  score          Int
  commentaire    String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([organisationId])
}

/// Nature d'une question d'un questionnaire d'évaluation :
/// OUI_NON (binaire), CHOIX_MULTIPLE (une réponse parmi `options`),
/// NOTE_MAX (note de 0 à `noteMax`), REPONSE_OUVERTE (texte libre),
/// SUGGESTION (texte libre orienté proposition d'amélioration).
enum TypeQuestion {
  OUI_NON
  CHOIX_MULTIPLE
  NOTE_MAX
  REPONSE_OUVERTE
  SUGGESTION
}

/// Formulaire de questions d'évaluation, éditable puis exportable en PDF.
/// `reponseFichier*` : un unique fichier de réponses (PDF ou tableur) téléversé
/// dans l'application et re-téléchargeable, remplacé à chaque nouvel envoi.
model Questionnaire {
  id                String       @id @default(uuid())
  titre             String
  description       String?      @db.Text
  reponseFichierUrl String?      @map("reponse_fichier_url")
  reponseFichierNom String?      @map("reponse_fichier_nom")
  organisationId    String
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  questions         Question[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organisationId])
}

model Question {
  id              String        @id @default(uuid())
  intitule        String        @db.Text
  type            TypeQuestion
  /// Choix proposés pour CHOIX_MULTIPLE ; vide pour les autres types.
  options         String[]      @default([])
  /// Borne haute pour NOTE_MAX (ex. 5, 10) ; null pour les autres types.
  noteMax         Int?          @map("note_max")
  ordre           Int           @default(0)
  questionnaireId String
  questionnaire   Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
}

// ─── Vision Canvas (module Vision — étape 1 de l'assistant TOGAF ADM) ─────────

/// Canevas de vision stratégique (façon Business Model Canvas), une ligne par
/// organisation. Champs volontairement en anglais — termes standards du
/// canevas (Target Group, Needs, Product...).
model VisionCanvas {
  id             String       @id @default(uuid())
  organisationId String       @unique
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  targetGroup    String?      @db.Text
  needs          String?      @db.Text
  product        String?      @db.Text
  businessGoals  String?      @db.Text
  competitors    String?      @db.Text
  revenueStreams String?      @db.Text
  costFactors    String?      @db.Text
  channels       String?      @db.Text
  updatedAt      DateTime     @updatedAt
}
