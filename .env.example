DATABASE_URL=postgresql://postgres:ChangeMeSecurely@localhost:5433/archivision?schema=public
JWT_SECRET=ChangeMeSecurely
PORT=3000
POSTGRES_PASSWORD=ChangeMeSecurely
FRONTEND_ORIGIN=http://localhost:4280

# URL de l'API utilisée par Nginx pour le proxy (Docker Compose local : http://api:3000).
# En production Railway : URL publique du service api (ex. https://api-xxx.railway.app).
NGINX_API_URL=http://api:3000

# Envoi d'e-mails (validation / rejet d'organisation par le superadmin).
# Laisser SMTP_HOST vide pour rester en mode simulé (journalisation seule).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ArchiVision <no-reply@archivision.local>
