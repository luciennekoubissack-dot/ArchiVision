generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  nom          String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Référentiel métier ───────────────────────────────────────────────────────

/// Entreprise modélisée (ex. K&B Groupe SARL).
model Organisation {
  id          String           @id @default(uuid())
  nom         String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  capacites   CapaciteMetier[]
  elements    ElementArchimate[]
  applications Application[]
  zones       ZoneUrbanisation[]
}

/// Ce que l'organisation sait faire (ex. "Gestion des formations").
model CapaciteMetier {
  id             String           @id @default(uuid())
  nom            String
  description    String?
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  elements       ElementArchimate[]
}

// ─── ArchiMate (couche Métier uniquement en v1) ───────────────────────────────

/// Types d'éléments ArchiMate v1 — couche Métier uniquement.
enum TypeElement {
  ACTEUR_METIER
  ROLE_METIER
  PROCESSUS_METIER
  SERVICE_METIER
  OBJET_METIER
}

/// Types de relations ArchiMate v1.
enum TypeRelation {
  ASSIGNATION
  COMPOSITION
  REALISATION
  ASSOCIATION
}

/// Élément de la couche Métier ArchiMate.
model ElementArchimate {
  id               String           @id @default(uuid())
  nom              String
  type             TypeElement
  description      String?
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId   String
  capacite         CapaciteMetier?  @relation(fields: [capaciteMetierId], references: [id])
  capaciteMetierId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  relationsSource  RelationArchimate[] @relation("RelationSource")
  relationsTarget  RelationArchimate[] @relation("RelationTarget")

  @@index([organisationId])
  @@index([type])
}

/// Lien typé entre deux éléments ArchiMate.
model RelationArchimate {
  id       String       @id @default(uuid())
  type     TypeRelation
  source   ElementArchimate @relation("RelationSource", fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId String
  target   ElementArchimate @relation("RelationTarget", fields: [targetId], references: [id], onDelete: Cascade)
  targetId String
  createdAt DateTime    @default(now())

  @@index([sourceId])
  @@index([targetId])
}

// ─── Urbanisation ─────────────────────────────────────────────────────────────

/// Criticité d'une application.
enum Criticite {
  HAUTE
  MOYENNE
  BASSE
}

/// Application du portefeuille applicatif.
model Application {
  id             String       @id @default(uuid())
  nom            String
  description    String?
  criticite      Criticite    @default(MOYENNE)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  zones          ApplicationZone[]

  @@index([organisationId])
}

/// Type d'un nœud de la hiérarchie d'urbanisation.
enum TypeZone {
  ZONE
  QUARTIER
  ILOT
}

/// Nœud de la hiérarchie Zone > Quartier > Îlot (auto-référencée).
model ZoneUrbanisation {
  id             String            @id @default(uuid())
  nom            String
  type           TypeZone
  parent         ZoneUrbanisation? @relation("ZoneHierarchie", fields: [parentId], references: [id])
  parentId       String?
  enfants        ZoneUrbanisation[] @relation("ZoneHierarchie")
  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  organisationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  applications   ApplicationZone[]

  @@index([organisationId])
  @@index([parentId])
}

/// Affectation d'une application à un îlot du POS.
model ApplicationZone {
  application   Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  zone          ZoneUrbanisation @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  zoneId        String

  @@id([applicationId, zoneId])
}
